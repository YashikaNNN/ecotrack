# Next.js reads this when the frontend starts or is built.
# The browser calls /backend/..., and Next.js forwards that to the API.
API_URL=http://127.0.0.1:8000

# FastAPI reads these from the environment of the API process.
# Paths are relative to the backend/ directory unless absolute.
MODEL_PATH=weights/best.pt
ECOTRACK_DB=data/ecotrack.db

# A scan is stored as accepted, with a bin and points, only at or above this confidence.
# The project reports do not define the number. 0.50 is the prototype rule.
CONFIDENCE_THRESHOLD=0.50

# Simulated bin fill is accepted scans divided by this capacity. It is not a sensor.
BIN_CAPACITY=20

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
